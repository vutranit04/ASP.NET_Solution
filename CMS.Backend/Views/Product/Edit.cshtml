@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h4>SỬA SẢN PHẨM</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="fw-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Giá</label>
                    <input asp-for="Price" type="number" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Hình ảnh sản phẩm</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Ảnh hiện tại" style="max-height: 150px; border-radius: 8px; border: 1px solid #ddd;" />
                            <p class="text-muted mt-1" style="font-size: 13px;">Ảnh hiện tại</p>
                        </div>
                    }
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Chọn file mới để thay đổi ảnh, hoặc bỏ trống để giữ ảnh cũ</small>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Danh mục</label>
                    <select asp-for="CategoryProductId"
                            asp-items="ViewBag.CategoryList"
                            class="form-select">
                    </select>
                </div>

                <button type="submit" class="btn btn-success">
                    Cập nhật
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</div>