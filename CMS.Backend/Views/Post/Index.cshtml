@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
}

@*
    //Họ và tên: Trần Minh Vũ
    //Mssv: 2122110359
    //Ngày tạo: 18/5/2026
    //Version: 1.0
*@

<div class="container mt-4">
    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>

    <div class="row mt-3">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height:200px; object-fit:cover;">
                    }
                    <div class="card-body">
                        <span class="badge bg-info text-dark">@item.Category?.Name</span>
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <p class="card-text text-truncate">@item.Content</p>
                        <p class="text-muted small">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>
                        <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                            <i class="bi bi-trash"></i> Xóa
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
