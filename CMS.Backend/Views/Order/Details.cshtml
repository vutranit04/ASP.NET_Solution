@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    
    // Tính tổng giá trị đơn hàng
    decimal totalOrderValue = 0;
    if (Model.OrderDetails != null)
    {
        totalOrderValue = Model.OrderDetails.Sum(od => od.Quantity * od.UnitPrice);
    }
}

<div class="container mt-4">
    <!-- Breadcrumb đồng bộ hệ thống -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Order">Danh sách đơn hàng</a></li>
            <li class="breadcrumb-item active">Chi tiết đơn hàng #@Model.Id</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h2 class="fw-bold text-primary mb-0">CHI TIẾT ĐƠN HÀNG #@Model.Id</h2>
                <div>
                    @if (Model.Status == 0)
                    {
                        <span class="badge bg-warning text-dark fs-6 py-2 px-3">Chờ xử lý</span>
                    }
                    else if (Model.Status == 1)
                    {
                        <span class="badge bg-primary fs-6 py-2 px-3">Đã thanh toán</span>
                    }
                    else if (Model.Status == 2)
                    {
                        <span class="badge bg-success fs-6 py-2 px-3">Đã giao</span>
                    }
                    else if (Model.Status == 3)
                    {
                        <span class="badge bg-danger fs-6 py-2 px-3">Đã hủy</span>
                    }
                </div>
            </div>

            <!-- Card chứa thông tin chung của Đơn hàng và Khách hàng -->
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <div class="row">
                        <!-- Thông tin đơn hàng -->
                        <div class="col-md-6 border-end pr-md-4">
                            <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-info-circle"></i> Thông tin đơn hàng</h5>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-muted">Ngày đặt:</div>
                                <div class="col-sm-8 fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 text-muted">Ghi chú:</div>
                                <div class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú" : Model.Notes)</div>
                            </div>
                            
                            <div class="row align-items-center mt-3">
                                <div class="col-sm-4 text-muted">Sửa trạng thái:</div>
                                <div class="col-sm-8">
                                    <!-- Dropdown cập nhật trạng thái trực tiếp (YC #4) -->
                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <select name="status" class="form-select form-select-sm" style="max-width: 180px;">
                                            <option value="0" selected="@(Model.Status == 0)">Chờ xử lý</option>
                                            <option value="1" selected="@(Model.Status == 1)">Đã thanh toán</option>
                                            <option value="2" selected="@(Model.Status == 2)">Đã giao</option>
                                            <option value="3" selected="@(Model.Status == 3)">Đã hủy</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-success">Cập nhật</button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin khách hàng -->
                        <div class="col-md-6 pl-md-4">
                            <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-person"></i> Thông tin khách hàng</h5>
                            @if (Model.Customer != null)
                            {
                                <div class="row mb-2">
                                    <div class="col-sm-4 text-muted">Họ và tên:</div>
                                    <div class="col-sm-8 fw-semibold">@Model.Customer.FullName</div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-sm-4 text-muted">Email:</div>
                                    <div class="col-sm-8">@Model.Customer.Email</div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-sm-4 text-muted">Điện thoại:</div>
                                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Customer.Phone) ? "Chưa cung cấp" : Model.Customer.Phone)</div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-sm-4 text-muted">Địa chỉ nhận:</div>
                                    <div class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model.Customer.Address) ? "Chưa cung cấp" : Model.Customer.Address)</div>
                                </div>
                            }
                            else
                            {
                                <p class="text-danger mb-0">Không tìm thấy thông tin khách hàng.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bảng danh sách mặt hàng đặt -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cart"></i> DANH SÁCH MẶT HÀNG ĐÃ ĐẶT</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;" class="ps-4">Hình ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-end" style="width: 140px;">Đơn giá</th>
                                    <th class="text-center" style="width: 100px;">Số lượng</th>
                                    <th class="text-end pe-4" style="width: 160px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                                {
                                    foreach (var detail in Model.OrderDetails)
                                    {
                                        var subTotal = detail.Quantity * detail.UnitPrice;
                                        <tr>
                                            <td class="ps-4">
                                                @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                {
                                                    <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #eee;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary text-white text-center rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 16px;">
                                                        🥋
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@detail.Product?.Name</div>
                                                <small class="text-muted">Mã sản phẩm: #@detail.ProductId</small>
                                            </td>
                                            <td class="text-end">
                                                @detail.UnitPrice.ToString("N0") đ
                                            </td>
                                            <td class="text-center">
                                                @detail.Quantity
                                            </td>
                                            <td class="text-end pe-4 fw-bold text-danger">
                                                @subTotal.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end fw-bold py-3">TỔNG CỘNG HÓA ĐƠN:</td>
                                        <td class="text-end pe-4 fw-bold text-danger fs-5 py-3">
                                            @totalOrderValue.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            Không có chi tiết mặt hàng trong đơn hàng này.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Nút điều hướng cuối trang -->
            <div class="mt-4 pb-5 border-top pt-3">
                <a href="/Order" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>