@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary">DANH SÁCH ĐƠN HÀNG</h2>

    <table class="table table-bordered table-hover shadow-sm">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Customer?.FullName</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                        }
                        else if (item.Status == 1)
                        {
                            <span class="badge bg-primary">Đã thanh toán</span>
                        }
                        else if (item.Status == 2)
                        {
                            <span class="badge bg-success">Đã giao</span>
                        }
                        else if (item.Status == 3)
                        {
                            <span class="badge bg-danger">Đã hủy</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không rõ (@item.Status)</span>
                        }
                    </td>
                    <td>

                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">Chi tiết</a>

                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-outline-danger btn-sm"
                           onclick="return confirm('Bạn có chắc muốn xóa đơn hàng này?')">Xóa</a>

                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>