@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary">
        DANH SÁCH CATEGORY PRODUCT
    </h2>

    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="bi bi-plus-circle"></i> Thêm Category Product
    </a>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">

                <div class="card shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 140px; object-fit: cover; border-top-left-radius: 8px; border-top-right-radius: 8px;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white text-center py-5" style="height: 140px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-size: 14px;">
                            Không có hình ảnh
                        </div>
                    }

                    <div class="card-body">

                        <h5 class="card-title text-primary">
                            @item.Name
                        </h5>

                        <p class="card-text text-muted text-truncate">
                            @item.Description
                        </p>

                        <p class="mb-1">
                            <span class="badge bg-success">
                                Display Order: @item.DisplayOrder
                            </span>
                        </p>

                        <p class="mb-2">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-info text-dark">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đang ẩn</span>
                            }
                        </p>

                        <div class="mt-3">

                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning">
                                Sửa
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa category này không?')">
                                Xóa
                            </a>

                         

                        </div>

                    </div>
                </div>

            </div>
        }

    </div>
</div>