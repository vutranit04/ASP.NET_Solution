@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa Danh Mục Sản Phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
				<i class="bi bi-pencil-square"></i> SỬA DANH MỤC SẢN PHẨM
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Hidden Id and ImageUrl -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên category..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="5"
                              placeholder="Nhập mô tả..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh đại diện:</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Ảnh hiện tại" style="max-height: 100px; border-radius: 8px; border: 1px solid #ddd;" />
                            <p class="text-muted mt-1" style="font-size: 12px;">Ảnh hiện tại</p>
                        </div>
                    }
                    <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Chọn file mới để thay đổi ảnh, hoặc bỏ trống để giữ ảnh cũ</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Thứ tự hiển thị:</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label fw-bold">
                        Hiển thị category
                    </label>
                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Cập nhật
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>